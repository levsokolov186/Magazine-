@page
@model FavoritesModel
@{
    ViewData["Title"] = "Избранное";
}

<div class="container py-5">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h1><i class="bi bi-heart-fill" aria-hidden="true"></i> Избранное</h1>
        <button class="btn btn-outline-secondary d-none" type="button" id="clearFavoritesBtn">
            <i class="bi bi-trash me-2" aria-hidden="true"></i>Очистить
        </button>
    </div>

    <div id="favoritesContainer">
        <div class="empty-state" id="emptyFavoritesMessage">
            <i class="bi bi-heart" aria-hidden="true" style="font-size: 5rem;"></i>
            <h2 class="h3">В избранном пусто</h2>
            <p class="mb-4">Выберите размер на странице товара и нажмите «В избранное»</p>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="bi bi-handbag me-2" aria-hidden="true"></i>Перейти в каталог
            </a>
        </div>

        <div class="row g-4" id="favoritesContent" style="display: none;">
        </div>
    </div>

    <div class="favorites-toast-container" id="toastContainer" aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/js/favorites-page.js" asp-append-version="true"></script>
}
