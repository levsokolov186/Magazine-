@page
@model CartModel
@{
    ViewData["Title"] = "Корзина";
}

<div class="container py-5">
    <div class="page-header">
        <h1><i class="bi bi-cart-fill" aria-hidden="true"></i> Корзина</h1>
    </div>

    <div id="cartContainer">
        <div class="empty-state" id="emptyCartMessage">
            <i class="bi bi-cart-x" aria-hidden="true" style="font-size: 5rem;"></i>
            <h2 class="h3">Корзина пуста</h2>
            <p class="mb-4">Добавьте товары из каталога</p>
            <a href="/" class="btn btn-primary btn-lg">
                <i class="bi bi-handbag me-2" aria-hidden="true"></i>Перейти в каталог
            </a>
        </div>

        <div class="row g-4" id="cartContent" style="display: none;">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body p-4" id="cartList"></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card sidebar-card sticky-top" style="top: 1rem; z-index: 100;">
                    <div class="card-body p-4">
                        <h2 class="h4 card-title">Итого</h2>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Товаров:</span>
                            <span class="fw-bold" id="totalItems">0 шт.</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 p-3 rounded-3 cart-summary-row">
                            <span class="fs-5 fw-bold">Сумма:</span>
                            <span class="fs-4 fw-bold price-color" id="totalPrice">0 ₽</span>
                        </div>
                        <button class="btn btn-primary w-100 btn-lg mb-3" type="button" id="checkoutBtn">
                            <i class="bi bi-bag-check me-2" aria-hidden="true"></i>Оформить заказ
                        </button>
                        <button class="btn btn-outline-secondary w-100" type="button" id="clearCartBtn">
                            <i class="bi bi-trash me-2" aria-hidden="true"></i>Очистить корзину
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-page.js" asp-append-version="true"></script>
}
