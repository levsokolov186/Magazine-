@model ShoesStore.Models.ProductInput
@{
    var emojiPlaceholder = string.IsNullOrEmpty(Model.Emoji) ? "👠" : null;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" aria-live="polite"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="Например: Туфли Elegance" autocomplete="off" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Описание товара..."></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="OldPrice" class="form-label"></label>
        <input asp-for="OldPrice" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="OldPrice" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" placeholder="Например: Женские туфли" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Emoji" class="form-label"></label>
        <input asp-for="Emoji" class="form-control" placeholder="@emojiPlaceholder" />
        <span asp-validation-for="Emoji" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Material" class="form-label"></label>
        <input asp-for="Material" class="form-control" placeholder="Например: Натуральная кожа" />
        <span asp-validation-for="Material" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" placeholder="Например: Чёрный" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
</div>
