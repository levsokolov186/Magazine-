@model List<ShoesStore.Models.ProductSize>
@using System.Globalization

<div class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="newSize">Добавить размер:</label>
    </div>
    <div class="col-auto">
        <input type="number" id="newSize" name="newSize" class="form-control" step="0.5" min="20" max="50" placeholder="Напр: 37.5" style="width: 120px;" />
    </div>
    <div class="col-auto">
        <button type="submit" name="action" value="add" class="btn btn-success btn-sm" formnovalidate>
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Добавить
        </button>
    </div>
</div>

@for (var i = 0; i < Model.Count; i++)
{
    <input type="hidden" name="SizeEntries[@i].Size" value="@Model[i].Size.ToString(CultureInfo.InvariantCulture)" />
    <input type="hidden" name="SizeEntries[@i].InStock" value="@Model[i].InStock.ToString().ToLowerInvariant()" />
}

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr>
                    <th>Размер</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.OrderBy(s => s.Size))
                {
                    var sizeText = entry.Size.ToString(CultureInfo.InvariantCulture);
                    <tr>
                        <td>
                            <strong class="fs-5">@sizeText</strong>
                        </td>
                        <td>
                            @if (entry.InStock)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>В наличии
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Нет в наличии
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="submit" name="action" value="toggle"
                                    class="btn btn-sm btn-outline-warning me-1" title="Переключить наличие"
                                    formnovalidate
                                    data-size-value="@sizeText"
                                    data-size-action="toggle">
                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                <span class="visually-hidden">Переключить наличие размера @sizeText</span>
                            </button>
                            <button type="submit" name="action" value="remove"
                                    class="btn btn-sm btn-outline-danger" title="Удалить размер"
                                    formnovalidate
                                    data-size-value="@sizeText"
                                    data-size-action="remove">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                                <span class="visually-hidden">Удалить размер @sizeText</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted text-center py-3">
        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>Добавьте размеры для этого товара
    </p>
}

<script>
    (function () {
        document.querySelectorAll('button[data-size-action]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                var size = btn.getAttribute('data-size-value');
                var input = document.getElementById('newSize');
                if (input) input.value = size;
                if (btn.getAttribute('data-size-action') === 'remove') {
                    if (!confirm('Удалить размер ' + size + '?')) {
                        e.preventDefault();
                    }
                }
            });
        });
    })();
</script>
