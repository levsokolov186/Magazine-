@page "{id:int}"
@model ShoesStore.Pages.Admin.EditModel
@{
    ViewData["Title"] = "Редактировать товар";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Назад к списку
        </a>
    </div>

    <h1 class="mb-4"><i class="bi bi-pencil" aria-hidden="true"></i> Редактировать товар</h1>

    <form method="post">
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body p-4">
                        <partial name="_ProductFormFields" model="Model.Product" />
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-light">
                        <h2 class="h5 mb-0"><i class="bi bi-rulers" aria-hidden="true"></i> Размеры и наличие</h2>
                    </div>
                    <div class="card-body p-4">
                        <partial name="_SizeManager" model="Model.Product.Sizes" />

                        <div class="mt-3">
                            <button type="submit" name="action" value="save" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-lg me-2" aria-hidden="true"></i>Сохранить изменения
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg">Отмена</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card sticky-top sidebar-card" style="top: 1rem; z-index: 100;">
                    <div class="card-body p-4">
                        <h2 class="h5 card-title mb-3">Информация</h2>
                        <div class="text-center mb-3">
                            <div class="rounded-4 d-flex align-items-center justify-content-center mb-3 product-preview-image"
                                 role="img" aria-label="Изображение товара">
                                @(string.IsNullOrEmpty(Model.Product.Emoji) ? "👠" : Model.Product.Emoji)
                            </div>
                        </div>
                        @if (Model.ProductCreatedAt.HasValue)
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-5 text-muted">Создан:</dt>
                                <dd class="col-sm-7">@Model.ProductCreatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
