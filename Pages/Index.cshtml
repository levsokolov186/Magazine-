@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Женская обувь";
}

<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Коллекция 2026</h1>
        <p class="hero-subtitle">Стильная и комфортная обувь для настоящих леди</p>
        <a href="#products" class="btn btn-hero">
            <i class="bi bi-arrow-down-circle me-2" aria-hidden="true"></i>Смотреть каталог
        </a>
    </div>
</section>

<section id="products" class="products-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Каталог</h2>
        </div>
        <div class="row g-4">
            @if (Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-4 col-lg-3 col-12">
                        <a class="product-card-link" href="@Url.Page("Product", new { id = product.Id })">
                            <div class="product-card">
                                <div class="product-image">
                                    <div class="placeholder-img" role="img" aria-label="@product.Name"><span>@product.Emoji</span></div>
                                    @if (product.HasDiscount)
                                    {
                                        <span class="badge-sale">@product.DiscountBadge</span>
                                    }
                                    else
                                    {
                                        <span class="badge-new">Новинка</span>
                                    }
                                </div>
                                <div class="product-info">
                                    <h3 class="product-name h5">@product.Name</h3>
                                    <p class="product-category">@product.Category</p>
                                    <p class="product-hint text-muted mb-2"><small><i class="bi bi-hand-index me-1" aria-hidden="true"></i>Нажмите, чтобы выбрать размер</small></p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <div>
                                            <span class="product-price">@product.Price.ToString("N0", CultureInfo.InvariantCulture).Replace(",", " ") ₽</span>
                                            @if (product.OldPrice.HasValue)
                                            {
                                                <br><small class="text-muted price-old">@product.OldPrice.Value.ToString("N0", CultureInfo.InvariantCulture).Replace(",", " ") ₽</small>
                                            }
                                        </div>
                                        <span class="btn btn-cart" role="presentation">
                                            <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Подробнее
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    <i class="bi bi-inbox" aria-hidden="true" style="font-size: 5rem;"></i>
                    <p class="mt-3">Товары скоро появятся</p>
                </div>
            }
        </div>
    </div>
</section>
