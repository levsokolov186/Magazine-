@page "{id:int}"
@model ProductModel
@using System.Globalization
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = Model.Name;
    var nameJs = JavaScriptEncoder.Default.Encode(Model.Name);
    var emojiJs = JavaScriptEncoder.Default.Encode(Model.Emoji);
    var categoryJs = JavaScriptEncoder.Default.Encode(Model.Category);
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Каталог</a></li>
            <li class="breadcrumb-item">@Model.Category</li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-6">
            <div class="product-detail-image rounded-4 d-flex align-items-center justify-content-center"
                 role="img" aria-label="@Model.Name">
                <span class="product-detail-emoji">@Model.Emoji</span>
            </div>
        </div>

        <div class="col-lg-6">
            @if (!string.IsNullOrEmpty(Model.Badge))
            {
                <span class="badge @(Model.HasDiscount ? "bg-danger" : "bg-success") mb-3 px-3 py-2 fs-6">@Model.Badge</span>
            }

            <h1 class="fw-bold mb-2">@Model.Name</h1>
            <p class="text-muted fs-5 mb-4">@Model.Category</p>

            <div class="mb-4">
                @if (Model.HasDiscount)
                {
                    var savings = Model.OldPrice!.Value - Model.Price;
                    <div class="d-flex align-items-baseline gap-3 mb-2">
                        <span class="fs-2 fw-bold price-color">@Html.Raw(Model.Price.ToString("N0", CultureInfo.InvariantCulture).Replace(",", "&nbsp;"))&nbsp;₽</span>
                        <span class="fs-5 text-muted price-old">@Html.Raw(Model.OldPrice!.Value.ToString("N0", CultureInfo.InvariantCulture).Replace(",", "&nbsp;"))&nbsp;₽</span>
                    </div>
                    <span class="badge bg-danger fs-6">Выгода @Html.Raw(savings.ToString("N0", CultureInfo.InvariantCulture).Replace(",", "&nbsp;"))&nbsp;₽</span>
                }
                else
                {
                    <span class="fs-2 fw-bold price-color">@Html.Raw(Model.Price.ToString("N0", CultureInfo.InvariantCulture).Replace(",", "&nbsp;"))&nbsp;₽</span>
                }
            </div>

            <hr>

            <div class="mb-4">
                <h2 class="h5 fw-bold mb-3">Размер <span class="text-danger" aria-hidden="true">*</span></h2>
                <div class="d-flex flex-wrap gap-2" id="sizeSelector" role="radiogroup" aria-label="Выбор размера">
                    @if (Model.Sizes.Any())
                    {
                        @foreach (var size in Model.Sizes.OrderBy(s => s.Size))
                        {
                            <button type="button" class="btn-size" role="radio" aria-checked="false" data-size="@size.Size.ToString(CultureInfo.InvariantCulture)">
                                @size.Size.ToString(CultureInfo.InvariantCulture)
                            </button>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Нет размеров в наличии</p>
                    }
                </div>
                <small class="text-danger mt-2 d-none" id="sizeError" role="alert">
                    <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>Пожалуйста, выберите размер
                </small>
            </div>

            <div class="mb-4">
                <h2 class="h5 fw-bold mb-3">Характеристики</h2>
                <dl class="product-specs">
                    <dt>Материал:</dt>
                    <dd>@Model.Material</dd>
                    <dt>Цвет:</dt>
                    <dd>@Model.Color</dd>
                </dl>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button class="btn btn-primary btn-lg flex-grow-1" id="addToCartBtn" type="button">
                    <i class="bi bi-cart-plus me-2" aria-hidden="true"></i>Добавить в корзину
                </button>
                <button class="btn btn-outline-danger btn-lg" id="addToFavBtn" type="button">
                    <i class="bi bi-heart me-2" aria-hidden="true"></i>В избранное
                </button>
            </div>
            <small class="text-danger mt-2 d-none" id="actionError" role="alert">
                <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>Сначала выберите размер
            </small>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-4 p-md-5">
                    <h2 class="h3 fw-bold mb-4">Описание</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="fs-5 text-muted">@Model.Description</p>
                    }
                    else
                    {
                        <p class="fs-5 text-muted">
                            @Model.Name — стильная и комфортная обувь из коллекции 2026 года.
                            @if (!string.IsNullOrEmpty(Model.Material) && Model.Material.Contains("кожа", StringComparison.OrdinalIgnoreCase))
                            {
                                <span>Изготовлено из натуральной кожи, которая обеспечивает долговечность и комфорт при носке.</span>
                            }
                            else
                            {
                                <span>Изготовлено из качественных материалов, которые обеспечивают долговечность и комфорт при носке.</span>
                            }
                            Идеально подходит для повседневной носки и создаёт элегантный образ.
                        </p>
                    }
                    <div class="row g-4 mt-3">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center gap-3">
                                <div class="feature-icon rounded-3 p-3">
                                    <i class="bi bi-shield-check" aria-hidden="true" style="font-size: 1.5rem;"></i>
                                </div>
                                <div>
                                    <h3 class="h6 mb-0 fw-bold">Гарантия качества</h3>
                                    <small class="text-muted">Качественный товар</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.PRODUCT_DATA = {
            id: @Model.ProductId,
            name: "@Html.Raw(nameJs)",
            price: @Model.Price.ToString(CultureInfo.InvariantCulture),
            emoji: "@Html.Raw(emojiJs)",
            category: "@Html.Raw(categoryJs)"
        };
    </script>
    <script src="~/js/product-page.js" asp-append-version="true"></script>
}
