@page
@model ShoesStore.Pages.Identity.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h1 class="h2 text-center mb-4">
                        <i class="bi bi-person-plus" aria-hidden="true"></i> Регистрация
                    </h1>

                    <form method="post">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" aria-live="polite"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Пароль</label>
                            <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                            <small class="text-muted">Минимум 6 символов, заглавная и строчная буква, цифра.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Подтверждение пароля</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Зарегистрироваться
                        </button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0">
                        Уже есть аккаунт? <a asp-page="/Identity/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Войти</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
